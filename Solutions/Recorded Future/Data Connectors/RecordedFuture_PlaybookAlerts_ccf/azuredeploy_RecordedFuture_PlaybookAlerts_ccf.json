{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "description": "PoC: deploys the Recorded Future Playbook Alerts CCF connector definition and an active RestApiPoller directly (no Content Hub). Deploy into the resource group that contains the workspace and the Recorded Future Data Connectors infrastructure (../azuredeploy.json). For manual testing."
    },
    "parameters": {
        "workspace": {
            "type": "string",
            "metadata": {
                "description": "Log Analytics workspace name (Sentinel enabled)."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Workspace location."
            }
        },
        "apiKey": {
            "type": "securestring",
            "metadata": {
                "description": "Recorded Future API token."
            }
        },
        "categories": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Optional comma-separated playbook alert categories."
            }
        },
        "priorities": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Optional comma-separated priorities."
            }
        },
        "statuses": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Optional comma-separated statuses."
            }
        }
    },
    "resources": [
        {
            "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/RecordedFuturePlaybookAlertsCCF')]",
            "apiVersion": "2022-09-01-preview",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
            "location": "[parameters('location')]",
            "kind": "Customizable",
            "properties": {
                "connectorUiConfig": {
                    "id": "RecordedFuturePlaybookAlertsCCF",
                    "title": "Recorded Future - Playbook Alerts (Codeless Connector)",
                    "publisher": "Recorded Future",
                    "descriptionMarkdown": "Imports [Recorded Future Playbook Alerts](https://support.recordedfuture.com/hc/en-us/articles/13152506878739-Playbook-Alerting-Rules) into the `RecordedFuturePlaybookAlerts_V2_CL` table using the Microsoft Sentinel Codeless Connector Framework (CCF). Replaces the `RecordedFuture-Playbook-Alert-Importer` Logic App. Requires the Recorded Future Data Connectors infrastructure (DCE, DCRs and tables) to be deployed in the workspace resource group first (see the **Recorded Future - Log Ingestion** connector).",
                    "graphQueriesTableName": "RecordedFuturePlaybookAlerts_V2_CL",
                    "graphQueries": [
                        {
                            "metricName": "Total playbook alerts received",
                            "legend": "RecordedFuturePlaybookAlerts_V2_CL",
                            "baseQuery": "{{graphQueriesTableName}}"
                        }
                    ],
                    "sampleQueries": [
                        {
                            "description": "Recent playbook alerts",
                            "query": "RecordedFuturePlaybookAlerts_V2_CL\n| sort by TimeGenerated desc"
                        },
                        {
                            "description": "Latest state of each playbook alert",
                            "query": "RecordedFuturePlaybookAlerts_V2_CL\n| summarize arg_max(updated_date, *) by id"
                        }
                    ],
                    "dataTypes": [
                        {
                            "name": "RecordedFuturePlaybookAlerts_V2_CL",
                            "lastDataReceivedQuery": "RecordedFuturePlaybookAlerts_V2_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                        }
                    ],
                    "connectivityCriteria": [
                        {
                            "type": "HasDataConnectors"
                        }
                    ],
                    "availability": {
                        "isPreview": true,
                        "status": 1
                    },
                    "permissions": {
                        "resourceProvider": [
                            {
                                "provider": "Microsoft.OperationalInsights/workspaces",
                                "permissionsDisplayText": "Read and Write permissions are required.",
                                "providerDisplayName": "Workspace",
                                "scope": "Workspace",
                                "requiredPermissions": {
                                    "write": true,
                                    "read": true,
                                    "delete": true
                                }
                            }
                        ],
                        "customs": [
                            {
                                "name": "Recorded Future Data Connectors infrastructure",
                                "description": "The shared DCE `recorded-future-dce` and DCR `recorded-future-dcr-playbook-alerts` must exist, with exactly these names, in the same resource group as the workspace. The names are fixed and not configurable. Deploy them with Step 1 of the **Recorded Future - Log Ingestion** connector."
                            },
                            {
                                "name": "Recorded Future API Token",
                                "description": "A Recorded Future API token with access to Playbook Alerts."
                            }
                        ]
                    },
                    "instructionSteps": [
                        {
                            "title": "1. Disable the Logic App importer",
                            "description": "If the `RecordedFuture-Playbook-Alert-Importer` Logic App is running, disable it before connecting, otherwise alerts are imported twice."
                        },
                        {
                            "title": "2. Configure",
                            "description": "Enter your Recorded Future API token. Filters are optional comma-separated lists; leave empty to import everything. Values are case-sensitive and must match exactly, e.g. `High,Moderate`.\n\nCategories: `code_repo_leakage`, `domain_abuse`, `identity_novel_exposures`, `third_party_risk`, `cyber_vulnerability`, `dark_web`, `malicious_sites`, `socmed_impersonation`.\n\nPriorities: `High`, `Moderate`, `Informational`.\n\nStatuses: `New`, `InProgress`, `Dismissed`, `Resolved`.",
                            "instructions": [
                                {
                                    "type": "Textbox",
                                    "parameters": {
                                        "label": "API Token",
                                        "placeholder": "Recorded Future API token",
                                        "type": "password",
                                        "name": "apiKey",
                                        "validations": {
                                            "required": true
                                        }
                                    }
                                },
                                {
                                    "type": "Textbox",
                                    "parameters": {
                                        "label": "Categories (optional)",
                                        "placeholder": "e.g. domain_abuse,cyber_vulnerability",
                                        "type": "text",
                                        "name": "categories"
                                    }
                                },
                                {
                                    "type": "Textbox",
                                    "parameters": {
                                        "label": "Priorities (optional)",
                                        "placeholder": "e.g. High,Moderate",
                                        "type": "text",
                                        "name": "priorities"
                                    }
                                },
                                {
                                    "type": "Textbox",
                                    "parameters": {
                                        "label": "Statuses (optional)",
                                        "placeholder": "e.g. New,InProgress",
                                        "type": "text",
                                        "name": "statuses"
                                    }
                                }
                            ]
                        },
                        {
                            "title": "3. Connect",
                            "description": "Make sure the `RecordedFuture-Playbook-Alert-Importer` Logic App is disabled first to avoid duplicate alerts. Then start polling Recorded Future every hour.",
                            "instructions": [
                                {
                                    "type": "ConnectionToggleButton",
                                    "parameters": {
                                        "connectLabel": "Connect",
                                        "disconnectLabel": "Disconnect",
                                        "name": "toggle"
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        },
        {
            "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/RecordedFuturePlaybookAlertsPoller')]",
            "apiVersion": "2023-02-01-preview",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "location": "[parameters('location')]",
            "kind": "RestApiPoller",
            "properties": {
                "connectorDefinitionName": "RecordedFuturePlaybookAlertsCCF",
                "dataType": "RecordedFuturePlaybookAlerts_V2_CL",
                "dcrConfig": {
                    "streamName": "Custom-RecordedFuturePlaybookAlerts_V2_CL",
                    "dataCollectionEndpoint": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', 'recorded-future-dce'), '2022-06-01').logsIngestion.endpoint]",
                    "dataCollectionRuleImmutableId": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'recorded-future-dcr-playbook-alerts'), '2022-06-01').immutableId]"
                },
                "auth": {
                    "type": "APIKey",
                    "ApiKey": "[parameters('apiKey')]",
                    "ApiKeyName": "X-RFToken"
                },
                "request": {
                    "apiEndpoint": "https://api.recordedfuture.com/gw/azure/playbook-alert/export",
                    "httpMethod": "GET",
                    "queryWindowInMin": 60,
                    "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
                    "startTimeAttributeName": "updated_from",
                    "endTimeAttributeName": "updated_until",
                    "rateLimitQPS": 5,
                    "retryCount": 3,
                    "timeoutInSeconds": 120,
                    "headers": {
                        "Accept": "application/json",
                        "User-Agent": "RecordedFuture-Sentinel-CCF"
                    },
                    "queryParameters": {
                        "categories": "[parameters('categories')]",
                        "priorities": "[parameters('priorities')]",
                        "statuses": "[parameters('statuses')]"
                    }
                },
                "response": {
                    "eventsJsonPaths": [
                        "$.data"
                    ],
                    "format": "json"
                },
                "paging": {
                    "pagingType": "Offset",
                    "offsetParaName": "from",
                    "pageSize": 25,
                    "pageSizeParameterName": "limit"
                }
            },
            "dependsOn": [
                "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectorDefinitions', 'RecordedFuturePlaybookAlertsCCF')]"
            ]
        }
    ]
}
