{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "String"
        }
    },
    "resources": [
        {
            "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/RecordedFutureClassicAlertsIncidentCreation')]",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/RecordedFutureClassicAlertsIncidentCreation')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "NRT",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "Recorded Future Alerts Incident Creation",
                "description": "'Create Recorded Future Classic Alerts in Microsoft Defender'\n",
                "severity": "Medium",
                "enabled": true,
                "query": "RecordedFutureClassicAlerts_V2_CL\n| where TimeGenerated >= now(-1h)\n",
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "tactics": [],
                "techniques": [],
                "subTechniques": [],
                "alertRuleTemplateName": null,
                "incidentConfiguration": {
                    "createIncident": true,
                    "groupingConfiguration": {
                        "enabled": true,
                        "reopenClosedIncident": false,
                        "lookbackDuration": "PT1H",
                        "matchingMethod": "Selected",
                        "groupByEntities": null,
                        "groupByAlertDetails": null,
                        "groupByCustomDetails": [
                            "RuleId"
                        ]
                    }
                },
                "eventGroupingSettings": {
                    "aggregationKind": "AlertPerResult"
                },
                "alertDetailsOverride": {
                    "alertDisplayNameFormat": "Alert: {{AlertName}}",
                    "alertDescriptionFormat": "_Recorded Future Alert_\n\nAlertID:\n{{AlertID}}\n\nTriggered: {{Triggered}}\n\nAI Summary: {{AISummary}}\n",
                    "alertDynamicProperties": [
                        {
                            "alertProperty": "AlertLink",
                            "value": "URL"
                        }
                    ]
                },
                "customDetails": {
                    "RuleName": "RuleName",
                    "RuleId": "RuleId"
                },
                "entityMappings": null,
                "sentinelEntitiesMappings": null,
                "templateVersion": null
            }
        }
    ]
}